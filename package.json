{
  "name": "saboria-commerce",
  "private": false,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@crevellari/backend",
    "backend:dev": "turbo dev --filter=@crevellari/backend",
    "storefront:dev": "turbo dev --filter=@crevellari/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "ajv": "^8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
